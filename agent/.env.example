# Copy this file to .env and fill in what you need. .env is gitignored —
# never commit your real key.

# Only required if you want the cloud path (general-knowledge/code questions,
# and only once you turn cloud access on in Settings or /api/settings/cloud).
# Everything else about ASTI works fully offline without this.
ANTHROPIC_API_KEY=

# Optional overrides — safe to leave unset, config.py's defaults are sane:
# ASTI_LOCAL_PROVIDER=ollama
# ASTI_LOCAL_MODEL=qwen2.5:14b
# ASTI_EMBEDDING_MODEL=nomic-embed-text
# ASTI_CLOUD_PROVIDER=anthropic
# ASTI_CLOUD_MODEL=claude-haiku-4-5
# ASTI_ALLOW_CLOUD=true
# ASTI_MAX_CLOUD_PROMPT_CHARS=2000
# ASTI_MAX_FILE_READ_CHARS=8000
